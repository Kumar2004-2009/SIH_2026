# NETRA - AI-Driven Multi-Vendor Network Security Compliance Auditor
# Copy this file to backend/.env and fill in your values

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=netra

# Application Settings
APP_ENV=development
SECRET_KEY=netra-sih2026-secret-change-in-production
DEBUG=true

# AI Integration (Optional - app works without this)
GEMINI_API_KEY=
AI_ENABLED=false

# CORS Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Backend Settings
HOST=0.0.0.0
PORT=8000
